{
  "manifest_version": 3,
  "name": "StudyJug",
  "version": "1.2.3",
  "description": "Remember vocabulary with language packs, coloured underlines and your own definitions.",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "icons": {
    "16": "icons/studyjug-16.png",
    "48": "icons/studyjug-48.png",
    "128": "icons/studyjug-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/studyjug-16.png",
      "48": "icons/studyjug-48.png",
      "128": "icons/studyjug-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "author": "James Pfaff (@TristanofJugdral)"
}
